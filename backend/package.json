{
  "name": "gmb-backend",
  "version": "1.0.0",
  "description": "Backend API for Google My Business profile management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required'",
    "test": "node --test tests/",
    "postinstall": "node -e \"if(process.env.RAILWAY_ENVIRONMENT==='prod'){try{require('child_process').execSync('npx --yes @fixprompt/cli deploy-start --status success',{stdio:'inherit'})}catch(e){console.warn('[fixprompt] deploy marker failed:',e.message)}}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@fixprompt/node": "^0.0.2",
    "@geos/loghub-client": "github:goscha01/geos-loghub-client",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^9.1.6",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "google-my-business",
    "api",
    "nodejs",
    "express",
    "social-media"
  ],
  "author": "",
  "license": "MIT"
}
