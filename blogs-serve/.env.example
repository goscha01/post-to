PORT=3002
NODE_ENV=production

# Supabase — same project as post-to backend, service role for full read access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LogHub / FixLoop — ships logs to Grafana Loki under service_name=post-to-blogs
LOGHUB_URL=https://geosloghub-production.up.railway.app
LOGHUB_SOURCE=post-to-blogs-prod
LOGHUB_KEY=
